# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Prisma SQLite for dev, PostgreSQL/MySQL for prod)
DATABASE_URL="file:./dev.db"

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SECRET=your_admin_secret_key_here
GOOGLE_CLIENT_ID=

# Business Logic TTLs
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=10
MAX_SEATS_PER_HOLD=10

# Email (SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CinePulse Tickets <tickets@cinepulse.com>"

# =========================================================================
# Production Cloud Object Storage (Option A: AWS S3 / Cloudflare R2)
# =========================================================================
# When these variables are set, the backend issues signed direct-to-cloud upload URLs.
# When left blank in local development, the system falls back to local uploads automatically.
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: For Cloudflare R2, MinIO, Supabase, or Backblaze B2 (e.g. https://<accountid>.r2.cloudflarestorage.com)
S3_ENDPOINT=

# Optional: CDN domain distribution (e.g. https://cdn.cinepulse.com or https://d12345.cloudfront.net)
CDN_URL=
